# Vercel frontend
VITE_API_URL=https://YOUR-RENDER-BACKEND.onrender.com/api

# Render web + worker + cron
NODE_ENV=production
MONGODB_URI=mongodb://USER:PASSWORD@HOST1:27017,HOST2:27017,HOST3:27017/bachelor_house_manager?ssl=true&replicaSet=REPLICA_SET&authSource=admin&appName=House
TOKEN_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
CLIENT_URL=https://YOUR-VERCEL-APP.vercel.app

DEFAULT_HOUSE_CAPACITY=5
MAX_HOUSE_CAPACITY=20
DEFAULT_MAX_TASKS_PER_DAY=4
HOUSE_TIME_ZONE=Asia/Kolkata
DAILY_GENERATE_HOUR=6
DAILY_GENERATE_MINUTE=0

WHATSAPP_ENABLED=true
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_WHATSAPP_FROM=whatsapp:+XXXXXXXXXXX
TWILIO_TASK_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TEST_CONTENT_SID=
TWILIO_ANNOUNCEMENT_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_REMINDER_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email verification
RESEND_API_KEY=
MAIL_FROM=
EMAIL_VERIFICATION_TTL_HOURS=24


# Security / scaling
API_RATE_LIMIT=1200
API_RATE_WINDOW_MS=60000
AUTH_RATE_LIMIT=15
AUTH_RATE_WINDOW_MS=900000

# Firebase Cloud Messaging
FCM_ENABLED=true
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
